// Recursos do "Abrir My Games.exe": o ícone do controle e as informações do arquivo.
1 ICON "my-games.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "My Games - hub de emulação"
      VALUE "ProductName", "My Games"
      VALUE "OriginalFilename", "Abrir My Games.exe"
      VALUE "FileVersion", "1.0"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
