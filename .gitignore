# =============================================================================
# My Games — o que NÃO vai para o GitHub
#
# Vai TUDO o que faz o hub funcionar só baixando o ZIP: o programa, o runtime
# do Windows, os emuladores (Windows e Linux) e as configurações deles.
# O emulador de N64 do Linux passa de 100 MB (limite do GitHub), por isso fica
# guardado em partes (.parte1, .parte2); o hub junta sozinho quando precisa.
#
# Fica de fora só o que é de cada pessoa:
#   - jogos (não podem ser distribuídos)
#   - saves, memory cards, save states, capturas de tela e listas de jogos
#   - BIOS (têm direitos autorais, como os jogos; cada um coloca a sua)
#   - configuração pessoal do hub (pastas de jogos deste computador)
# =============================================================================

# -----------------------------------------------------------------------------
# Jogos
# -----------------------------------------------------------------------------
Emuladores/*/Adicionar Jogos/*
!Emuladores/*/Adicionar Jogos/.gitkeep

# Rede de segurança: jogo esquecido em qualquer outra pasta do hub
*.iso
*.cso
*.zso
*.chd
*.rvz
*.gcm
*.gcz
*.wbfs
*.wia
*.ciso
*.nkit.*
*.z64
*.n64
*.v64
*.sfc
*.smc
*.fig
*.swc
*.gba
*.gbc
*.gb
*.neo
*.pbp
*.mdf
*.mds
*.ecm
# .zip/.7z/.rar/.bin/.cue/.img também são jogos, mas os emuladores usam essas
# extensões nos próprios arquivos: por isso só valem soltos na pasta do console.
Emuladores/*/*.zip
Emuladores/*/*.7z
Emuladores/*/*.rar
Emuladores/*/*.bin
Emuladores/*/*.cue
Emuladores/*/*.img

# -----------------------------------------------------------------------------
# BIOS (cada pessoa coloca a sua em Emuladores/<Console>/bios)
# -----------------------------------------------------------------------------
Emuladores/*/bios/*
!Emuladores/*/bios/.gitkeep
Emuladores/*/Windows/bios/
Emuladores/*/Windows/system/

# -----------------------------------------------------------------------------
# Saves, memory cards, save states, capturas de tela e listas de jogos
# (as configurações dos emuladores vão; só o que é dos jogos fica de fora)
# -----------------------------------------------------------------------------
Emuladores/**/saves/
Emuladores/**/Saves/
Emuladores/**/Save/
Emuladores/**/states/
Emuladores/**/StateSaves/
Emuladores/**/sstates/
Emuladores/**/memcards/
Emuladores/**/screenshots/
Emuladores/**/Screenshots/
Emuladores/**/ScreenShots/
Emuladores/**/snaps/
Emuladores/**/videos/
Emuladores/**/covers/
Emuladores/**/thumbnails/
Emuladores/**/playlists/
Emuladores/*/dados/dolphin/GC/
Emuladores/*/dados/dolphin/Wii/
Emuladores/*/dados/dolphin/Load/
Emuladores/*/dados/dolphin/Dump/
Emuladores/**/content_history.lpl
Emuladores/**/library.sqlite3
Emuladores/**/playtime.dat
*.srm
*.sav
*.eep
*.fla
*.sra
*.mpk
*.mcr
*.ps2
*.gci
*.p2s
*.frz
*.state
*.state[0-9]*
*.ss[0-9]
*.st[0-9]

# Caches e registros dos emuladores (eles refazem sozinhos)
Emuladores/**/cache/
Emuladores/**/Cache/
Emuladores/**/logs/
Emuladores/**/Logs/
Emuladores/**/*.cache
Emuladores/**/*.log
Emuladores/**/nointro.sqlite3

# Configuração pessoal do hub (caminhos das pastas de jogos deste computador),
# registros e capas baixadas
Sistema/config.json
Sistema/logs/
Sistema/capas/

# -----------------------------------------------------------------------------
# Arquivos temporários e de compilação
# -----------------------------------------------------------------------------
*.part
*.tmp
.portable-*
__pycache__/
*.pyc
Sistema/launcher/*.res
Thumbs.db
desktop.ini
.DS_Store

# -----------------------------------------------------------------------------
# Segurança: chaves, senhas e tokens nunca vão para o GitHub
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.token
credentials*.json
secrets*.json
# Login/token do RetroAchievements no Dolphin
Emuladores/**/RetroAchievements.ini
# Exceção: certificados públicos de SSL do runtime (necessários para o HTTPS funcionar)
!Sistema/windows/runtime/**/*.pem
